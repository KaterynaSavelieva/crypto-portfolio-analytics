@startuml
title UML Class Diagram - ETL System
left to right direction
skinparam classAttributeIconSize 0

package "API Layer" {
    class ApiClient {
        +fetch_with_retry(url, params)
    }

    class ExchangeRateAPI {
        +get_eur_rate(date)
    }

    class MarketPriceAPI {
        +get_market_prices()
        +get_historical_prices()
    }
}

package "ETL Layer" {

    class ExtractMarketPrices {
        +extract_current_prices()
    }

    class ExtractHistoricalPrices {
        +extract_historical_prices()
    }

    class UpdateMarketPrices {
        +run_update()
    }

    class GenerateTransactions {
        +generate_transactions()
    }

    class BuildPortfolioSnapshot {
        +build_snapshot()
    }
}

package "Data Layer" {

    class DatabaseConnection {
        +create_connection()
    }

    class MarketPriceLoader {
        +save_market_prices()
        +save_historical_prices()
    }

    class SnapshotLoader {
        +insert_snapshot()
        +clear_snapshot()
    }
}

package "Utils" {
    class Logger {
        +get_logger()
        +info()
        +error()
    }

    class Formatter {
        +print_header()
    }
}

package "Model" {
    class Asset {
        -asset_id
        -asset_symbol
    }

    class MarketPrice {
        -asset_id
        -price_date
        -price_eur
    }
}

' API usage
ApiClient ..> ExchangeRateAPI : uses
ApiClient ..> MarketPriceAPI : uses

' ETL flow
MarketPriceAPI ..> ExtractMarketPrices
MarketPriceAPI ..> UpdateMarketPrices
ExchangeRateAPI ..> ExtractHistoricalPrices

ExtractMarketPrices --> MarketPriceLoader
ExtractHistoricalPrices --> MarketPriceLoader
UpdateMarketPrices --> MarketPriceLoader

' New flow
UpdateMarketPrices --> GenerateTransactions
GenerateTransactions --> BuildPortfolioSnapshot

BuildPortfolioSnapshot --> SnapshotLoader

' DB usage
MarketPriceLoader --> DatabaseConnection
SnapshotLoader --> DatabaseConnection

' Models
MarketPriceLoader ..> Asset
MarketPriceLoader ..> MarketPrice
BuildPortfolioSnapshot ..> MarketPrice

' Utils usage
UpdateMarketPrices ..> Logger
GenerateTransactions ..> Logger
BuildPortfolioSnapshot ..> Logger

@enduml